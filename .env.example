# ------------------------------------------------------------------
# StudioSpace environment variables
#
# Copy this file to ".env.local" and fill in YOUR OWN values.
# ".env.local" is git-ignored; never commit real credentials.
# Vercel → Project Settings → Environment Variables needs the same keys.
# ------------------------------------------------------------------

# ── Application URL ───────────────────────────────────────────────
# Local: http://localhost:3000
# Production: your deployed https URL, e.g. https://studiospace.vercel.app
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Better Auth ───────────────────────────────────────────────────
# Secret used to sign/encrypt session tokens.
# Generate one locally:  node -e "console.log(crypto.randomBytes(32).toString('base64'))"
# (In the shell you may need:  node --input-type=module -e "...")
BETTER_AUTH_SECRET=replace-with-a-long-random-secret

# ── MongoDB (real cluster, never the tutorial placeholder) ───────
# Copy from MongoDB Atlas → Database → Connect → Drivers.
# A REAL host looks like:  cluster0.abc12.mongodb.net
# Do NOT keep the placeholder host "cluster.mongodb.net".
# Put the database name in DB_NAME below
# (Atlas may also embed it in the URI path — DB_NAME takes precedence).
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@clusterHOST/?retryWrites=true&w=majority
DB_NAME=studioSpace

# ── Google OAuth (Google Cloud Console → Credentials → OAuth 2.0) ─
# Authorized JavaScript origins:  http://localhost:3000  and your https URL
# Authorized redirect URIs:      https://YOUR-APP/api/auth/callback/google
GOOGLE_CLIENT_ID=your-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-oauth-client-secret
